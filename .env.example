# Wardstone deployment environment (docker compose). Copy beside your
# compose invocation, keep mode 0600, and never commit it.

# REQUIRED: the certificate SAN / the ACME URL basis, e.g. ca.example.test
WARDSTONE_SERVER_HOSTNAME=

# REQUIRED (Bundled variant only): the bundled Postgres' BOOTSTRAP password.
# It initializes the database and seeds the first credential. The FIRST
# UNLOCK retires it (the instance rotates to a fresh in-memory credential,
# sealed under your master passphrase). After setup you may rotate this
# value in your secret store or drop it from the file entirely.
WARDSTONE_DB_PASSWORD=

# The image to run. Default: wardstone:latest (build locally); for the
# published build:
# WARDSTONE_IMAGE=ghcr.io/draco-lunaris/wardstone:latest

# Public URL base for the ACME surface when clients reach a non-standard
# port; default: https://$WARDSTONE_SERVER_HOSTNAME
# WARDSTONE_PUBLIC_URL=
